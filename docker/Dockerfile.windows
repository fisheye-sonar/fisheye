# Dockerfile.windows11

# Use NVIDIA’s PyTorch image with CUDA (already has torch, torchvision, etc.)
FROM nvcr.io/nvidia/pytorch:24.04-py3

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy poetry files first for caching
COPY pyproject.toml poetry.lock README.md ./

# Copy the rest of the codebase
COPY . .

RUN curl -sSL https://install.python-poetry.org | python3 - && \
    ~/.local/bin/poetry config virtualenvs.create false && \
    ~/.local/bin/poetry install --no-interaction --no-ansi

# Make sure all entrypoints and scripts use bash
SHELL ["/bin/bash", "-c"]